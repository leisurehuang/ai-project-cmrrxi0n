// Prisma 数据源配置
datasource db {
  provider = "postgresql" // 生产环境推荐使用 postgresql
  url      = env("DATABASE_URL")
}

// Prisma Client 生成器配置
generator client {
  provider = "prisma-client-js"
}

/// 玩家存档模型
model PlayerProfile {
  id         String   @id @default(uuid()) // 数据库主键
  openid     String   @unique // 微信用户 openid，唯一索引
  coins      Int      @default(0) // 拥有的金币数量
  maxWave    Int      @default(0) // 历史最高通过的波数
  talents    Json     @default("{}") // 永久天赋树等级字典，如 { "hp": 5, "speed": 3 }
  skins      String[] @default([]) // 已拥有的皮肤ID列表
  activeSkin String   @default("default") // 当前装备的皮肤ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([openid]) // 为openid建立索引提升查询效率
}

/// 单局战斗记录模型
model BattleRecord {
  id        String   @id @default(uuid()) // 记录唯一标识
  openid    String   // 关联的玩家
  score     Int      @default(0) // 单局得分（用于好友排行榜）
  wave      Int      @default(0) // 通关波数
  kills     Int      @default(0) // 击杀总数
  timestamp DateTime @default(now()) // 战斗结算时间

  @@index([openid]) // 玩家维度查询索引
  @@index([score])   // 排行榜分数排序索引
}
