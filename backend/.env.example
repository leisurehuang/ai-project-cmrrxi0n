# ===== 运行环境 =====
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# ===== PostgreSQL =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kids_rewards?schema=public

# ===== Redis（缓存 + 分布式锁）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT 鉴权 =====
JWT_SECRET=replace-me-with-a-secure-secret-key
JWT_EXPIRES_IN=7d

# ===== 微信小程序 =====
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret
